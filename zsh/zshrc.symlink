# PATH and fpath hold each directory once; the base PATH comes from .zprofile.
typeset -U path fpath

# shortcut to my dotfiles path is $DOT (resolved from this file's symlink)
export DOT=${${(%):-%x}:A:h:h}

# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh

# Starship draws the prompt; fall back to an oh-my-zsh theme without it.
if (( $+commands[starship] )); then
  ZSH_THEME=""
else
  ZSH_THEME="alex"
fi

# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to disable bi-weekly auto-update checks.
# DISABLE_AUTO_UPDATE="true"

# Uncomment the following line to change how often to auto-update (in days).
# export UPDATE_ZSH_DAYS=13

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to disable command auto-correction.
# DISABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# The optional three formats: "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
HIST_STAMPS="dd.mm.yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

######################################################################

# TMUX
if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
  ZSH_TMUX_AUTOSTART=false
elif [ "$TERM_PROGRAM" = "vscode" ]; then
  ZSH_TMUX_AUTOSTART=false
elif [ -n "$ZSH_EXECUTION_STRING" ] || [ ! -t 0 ] || [ ! -t 1 ]; then
  # `zsh -ilc ...` or no TTY (GUI apps reading the login env): never attach tmux
  ZSH_TMUX_AUTOSTART=false
else
  ZSH_TMUX_AUTOSTART=true
fi

#ZSH_TMUX_AUTOSTART=true
#ZSH_TMUX_AUTOSTART_ONCE=true
#ZSH_TMUX_AUTOCONNECT=true

######################################################################

# History
# stop sharing the history
unsetopt share_history

######################################################################

# Which plugins would you like to load? (plugins can be found in ~/.oh-my-zsh/plugins/*)
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
plugins=(tmux git macos sudo colored-man-pages)
plugins+=(npm node)
plugins+=(brew pod swiftpm react-native bundler pip gem)
plugins+=(docker docker-compose)
plugins+=(aws terraform)
plugins+=(kubectl helm)
plugins+=(rust)
plugins+=(zsh-autosuggestions)
# must stay last: it wraps every zle widget defined before it
plugins+=(zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# User configuration

# You may need to manually set your language environment
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
	export EDITOR='vim'
else
	export EDITOR='code --wait --new-window'
fi

# ssh: macOS launchd provides the agent; start one only if it is missing,
# then add the keys stored in the keychain
if [ -z "$SSH_AUTH_SOCK" ]; then
	eval $(ssh-agent -s)
fi
ssh-add --apple-load-keychain 2>/dev/null

# autosuggestion
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=240"

# My own additions:
if [ -f ~/.zshrc_local ]; then
	source ~/.zshrc_local
fi

# DOTFILES
################################################################################

# all of our zsh files
typeset -U config_files
config_files=($DOT/**/*.zsh)

# load the path files
for path_file in ${(M)config_files:#*/path.zsh}; do 
  source $path_file
done

# load the alias files
for alias_file in ${(M)config_files:#*/aliases.zsh}; do
  source $alias_file
done

# load the config files
for config_file in ${(M)config_files:#*/config.zsh}; do
  source $config_file
done

# pnpm (keep the markers: `pnpm setup` looks for them before editing this file)
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# drop PATH entries for directories that do not exist on this machine
path=($^path(N-/))

################################################################################

# Starship
################################################################################
(( $+commands[starship] )) && eval "$(starship init zsh)"
