# Login shells only, once, before .zshrc. Sets the base PATH every shell below
# inherits; /etc/zprofile (path_helper) has already run. .zshrc only appends.

# Homebrew
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# OrbStack: CLI tools on PATH, completions on fpath (before compinit)
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
